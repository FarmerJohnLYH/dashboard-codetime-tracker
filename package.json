{
  "name": "dashboard-simple-code-time-tracker",
  "displayName": "Dashboard - a simple code time tracker",
  "description": "Local project time, document changes and editor activity tracking with a minimal dashboard.",
  "version": "1.3.0",
  "publisher": "YuanhaoLiu",
  "engines": {
    "vscode": "^1.85.0",
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "scripts": {
    "test": "node scripts/check-runtime.cjs && node --test test/*.test.js",
    "test:coverage": "node scripts/check-runtime.cjs && node --experimental-test-coverage --test test/*.test.js",
    "test:browser": "node scripts/check-runtime.cjs && node test/ui.cjs",
    "test:host": "node scripts/test-host.cjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "dashboard.open",
        "title": "Dashboard: Open"
      },
      {
        "command": "dashboard.export",
        "title": "Dashboard: Export Raw Data"
      }
    ],
    "configuration": {
      "title": "Dashboard",
      "properties": {
        "dashboard.idleMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "description": "Active time stops after this many minutes without editor activity."
        }
      }
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@vscode/vsce": "^4.1.1",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FarmerJohnLYH/dashboard-codetime-tracker.git"
  },
  "icon": "media/icon.png"
}
